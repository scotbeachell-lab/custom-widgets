<!-- Tag sets where the widget first appears and its starting layer. Drag the top bar to move it. -->
<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:arcade="clr-namespace:CustomWidgets;assembly=WidgetHost"
        Style="{StaticResource Card}" Padding="8" Tag="bottom-center top">
  <StackPanel>
    <DockPanel Margin="4,0,4,6">
      <TextBlock Style="{StaticResource Text}" FontWeight="SemiBold" Text="MINI ARCADE"/>
      <TextBlock Style="{StaticResource Muted}" HorizontalAlignment="Right" FontSize="11"
                 Text="Arrows move  &#xB7;  Space fire  &#xB7;  P pause  &#xB7;  M menu"/>
    </DockPanel>
    <arcade:ArcadeView Width="400" Height="300"/>
  </StackPanel>
</Border>
