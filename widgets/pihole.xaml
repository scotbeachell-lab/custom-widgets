<!-- Pi-hole stats. Every value comes from {Binding Pihole.Something}; see the README. -->
<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        Style="{StaticResource Card}" Width="332">
  <StackPanel>

    <!-- Status -->
    <DockPanel>
      <Ellipse DockPanel.Dock="Left" Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center"
               Fill="{Binding Pihole.StatusBrush}"/>
      <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" VerticalAlignment="Center" Text="Pi-hole"/>
      <TextBlock Style="{StaticResource Text}" FontSize="15" FontWeight="SemiBold" Text="{Binding Pihole.Status}"/>
    </DockPanel>
    <TextBlock Style="{StaticResource Muted}" Margin="18,2,0,12" TextWrapping="Wrap" Text="{Binding Pihole.StatusDetail}"/>

    <!-- Headline numbers -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition/>
        <ColumnDefinition/>
        <ColumnDefinition/>
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Style="{StaticResource Muted}" Text="Queries"/>
        <TextBlock Style="{StaticResource Text}" FontSize="22" FontFamily="{StaticResource DisplayFont}" Text="{Binding Pihole.Total}"/>
      </StackPanel>
      <StackPanel Grid.Column="1">
        <TextBlock Style="{StaticResource Muted}" Text="Blocked"/>
        <TextBlock Style="{StaticResource Text}" FontSize="22" FontFamily="{StaticResource DisplayFont}" Text="{Binding Pihole.Blocked}"/>
      </StackPanel>
      <StackPanel Grid.Column="2">
        <TextBlock Style="{StaticResource Muted}" Text="Block rate"/>
        <TextBlock Style="{StaticResource Text}" FontSize="22" FontFamily="{StaticResource DisplayFont}"
                   Foreground="{StaticResource Accent2Brush}" Text="{Binding Pihole.PercentText}"/>
      </StackPanel>
    </Grid>
    <ProgressBar Style="{StaticResource Meter}" Foreground="{StaticResource Accent2Brush}" Margin="0,10,0,0"
                 Value="{Binding Pihole.PercentBlocked, Mode=OneWay}"/>

    <!-- History. HistoryTotal and HistoryBlocked: x 0 to 298, y 0 to 56. -->
    <Grid Height="56" Margin="0,12,0,4">
      <Border VerticalAlignment="Top" Height="1" Background="{StaticResource HoverBrush}"/>
      <Border VerticalAlignment="Center" Height="1" Background="{StaticResource HoverBrush}"/>
      <Border VerticalAlignment="Bottom" Height="1" Background="{StaticResource HoverBrush}"/>
      <Polygon Points="{Binding Pihole.HistoryTotal}" Fill="#558FA8FF" Stroke="{StaticResource AccentBrush}" StrokeThickness="1"/>
      <Polygon Points="{Binding Pihole.HistoryBlocked}" Fill="#99FFB27A" Stroke="{StaticResource Accent2Brush}" StrokeThickness="1"/>
      <TextBlock Style="{StaticResource Muted}" FontSize="10" HorizontalAlignment="Right" Margin="0,2,0,0" Text="{Binding Pihole.HistoryScale}"/>
    </Grid>
    <DockPanel Margin="0,0,0,10">
      <TextBlock Style="{StaticResource Muted}" FontSize="10" Text="Last 24 hours"/>
      <TextBlock Style="{StaticResource Muted}" FontSize="10" HorizontalAlignment="Right">
        <Run Text="&#x25A0;" Foreground="{StaticResource AccentBrush}"/> all
        <Run Text="  &#x25A0;" Foreground="{StaticResource Accent2Brush}"/> blocked
      </TextBlock>
    </DockPanel>

    <!-- Smaller stats -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition/>
        <ColumnDefinition/>
        <ColumnDefinition/>
        <ColumnDefinition/>
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Style="{StaticResource Muted}" Text="Rate"/>
        <TextBlock Style="{StaticResource Text}" Text="{Binding Pihole.Rate}"/>
      </StackPanel>
      <StackPanel Grid.Column="1">
        <TextBlock Style="{StaticResource Muted}" Text="Cached"/>
        <TextBlock Style="{StaticResource Text}" Text="{Binding Pihole.CachedPercent}"/>
      </StackPanel>
      <StackPanel Grid.Column="2">
        <TextBlock Style="{StaticResource Muted}" Text="Domains"/>
        <TextBlock Style="{StaticResource Text}" Text="{Binding Pihole.UniqueDomains}"/>
      </StackPanel>
      <StackPanel Grid.Column="3">
        <TextBlock Style="{StaticResource Muted}" Text="Devices"/>
        <TextBlock Style="{StaticResource Text}" Text="{Binding Pihole.Clients}"/>
      </StackPanel>
    </Grid>

    <Border Height="1" Margin="0,10" Background="{StaticResource HoverBrush}"/>

    <TextBlock Style="{StaticResource Muted}" Text="Top blocked" Margin="0,0,0,6"/>
    <ItemsControl ItemsSource="{Binding Pihole.TopBlocked}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <DockPanel Height="19">
            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" Margin="8,0,0,0" Text="{Binding Count, StringFormat=N0}"/>
            <TextBlock Style="{StaticResource Text}" TextTrimming="CharacterEllipsis" Text="{Binding Name}" ToolTip="{Binding Name}"/>
          </DockPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <Border Height="1" Margin="0,10" Background="{StaticResource HoverBrush}"/>

    <TextBlock Style="{StaticResource Muted}" Text="Busiest devices" Margin="0,0,0,6"/>
    <ItemsControl ItemsSource="{Binding Pihole.TopClients}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <DockPanel Height="19">
            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" Margin="8,0,0,0" Text="{Binding Count, StringFormat=N0}"/>
            <TextBlock Style="{StaticResource Text}" TextTrimming="CharacterEllipsis" Text="{Binding Name}"/>
          </DockPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <Border Height="1" Margin="0,10" Background="{StaticResource HoverBrush}"/>

    <TextBlock Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis">
      Block list <Run Foreground="{StaticResource TextBrush}" Text="{Binding Pihole.BlockList, Mode=OneWay}"/>
      domains, <Run Text="{Binding Pihole.BlockListAge, Mode=OneWay}"/>
    </TextBlock>
  </StackPanel>
</Border>
