<!-- Sends the same keys as a keyboard's media buttons, so it controls whichever player is active. -->
<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        Style="{StaticResource Card}" Padding="6">
  <StackPanel Orientation="Horizontal">
    <Button Style="{StaticResource IconButton}" Content="&#xE892;" ToolTip="Previous"
            Command="{Binding Media}" CommandParameter="prev"/>
    <Button Style="{StaticResource IconButton}" Content="&#xE768;" ToolTip="Play or pause"
            Command="{Binding Media}" CommandParameter="play"/>
    <Button Style="{StaticResource IconButton}" Content="&#xE893;" ToolTip="Next"
            Command="{Binding Media}" CommandParameter="next"/>
    <Button Style="{StaticResource IconButton}" Content="&#xE74F;" ToolTip="Mute"
            Command="{Binding Media}" CommandParameter="mute"/>
  </StackPanel>
</Border>
